{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "coordinator",
  "skills": [
    "./.agents/skills"
  ],
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--no-usage-statistics"]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "ctx7sk-927a1c3b-ae22-40b3-a62d-0395ee6b403b"
        }
      }
    }
  },
  "provider": {
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "sk-6b12b9d976f1f698-23efa8-321d17b5"
      },
      "models": {
        "dva/kimi-k2-7": {
          "name": "kimi-k2-7"
        },
        "cfp/zai-org/glm-5.2": {
          "name": "glm-5.2"
        }
      }
    }
  }
}

